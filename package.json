{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "A public Discord bot with a website invite page and customization dashboard",
  "scripts": {
    "start": "concurrently \"npm run bot\" \"npm run server\"",
    "bot": "node bot/index.js",
    "server": "node server/index.js",
    "deploy": "node bot/deploy-commands.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "concurrently": "^8.2.2",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.1.1"
  }
}
